# F1 Data Seeding Configuration
# 
# DEFAULT BEHAVIOR (when no environment variables are set):
# - F1_SEASON_START_YEAR = 2005 
# - F1_SEASON_END_YEAR = Current Year (automatically detected)
#
# To override defaults, uncomment and set these values:

# For fast testing (only 3 years) - RECOMMENDED FOR DEVELOPMENT
# F1_SEASON_START_YEAR=2022
# F1_SEASON_END_YEAR=2024

# For custom range:
# F1_SEASON_START_YEAR=2010
# F1_SEASON_END_YEAR=2020 